  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks connectivity to Redis, Temporal, Supplier A, and Supplier B."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 503\", function () {",
                  "    pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Response has status and services object\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('services');",
                  "    pm.expect(json.services).to.have.property('redis');",
                  "    pm.expect(json.services).to.have.property('temporal');",
                  "    pm.expect(json.services).to.have.property('supplierA');",
                  "    pm.expect(json.services).to.have.property('supplierB');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mock Suppliers",
      "item": [
        {
          "name": "GET /supplierA/hotels?city=delhi",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["supplierA", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Returns raw hotel offers from Supplier A for Delhi."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array of hotel offers\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0]).to.have.property('hotelId');",
                  "        pm.expect(json[0]).to.have.property('name');",
                  "        pm.expect(json[0]).to.have.property('price');",
                  "        pm.expect(json[0]).to.have.property('city', 'delhi');",
                  "        pm.expect(json[0]).to.have.property('commissionPct');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
