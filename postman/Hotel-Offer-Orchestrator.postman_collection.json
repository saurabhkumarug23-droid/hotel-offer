                  "value": "5000"
                },
                {
                  "key": "maxPrice",
                  "value": "7000"
                }
              ]
            },
            "description": "Queries Redis Sorted Set for offers between 5000 and 7000."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned hotels are within price range\", function () {",
                  "    var json = pm.response.json();",
                  "    json.forEach(function(h) {",
                  "        pm.expect(h.price).to.be.at.least(5000);",
                  "        pm.expect(h.price).to.be.at.most(7000);",
                  "    });",
                  "});"
