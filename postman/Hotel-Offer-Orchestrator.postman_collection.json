    "name": "Hotel Offer Orchestrator",
    "description": "Comprehensive Postman collection for Hotel Offer Orchestrator API including Health, Mock Suppliers, Aggregated Offers, and Redis-backed Price Filtering.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
