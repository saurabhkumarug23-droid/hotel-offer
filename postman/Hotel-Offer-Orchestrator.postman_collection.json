    {
      "name": "Hotel Aggregation & Filtering",
      "item": [
        {
          "name": "GET /api/hotels?city=delhi (Full Aggregation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Orchestrates Temporal workflow (or returns Redis cache) and outputs deduplicated cheapest hotel offers."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array of deduplicated offers\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0]).to.have.property('name');",
                  "        pm.expect(json[0]).to.have.property('price');",
                  "        pm.expect(json[0]).to.have.property('supplier');",
                  "        pm.expect(json[0]).to.have.property('commissionPct');",
                  "        pm.expect(json[0]).to.not.have.property('hotelId');",
                  "        pm.expect(json[0]).to.not.have.property('city');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
