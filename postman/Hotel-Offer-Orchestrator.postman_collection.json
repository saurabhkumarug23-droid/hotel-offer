        {
          "name": "GET /api/hotels?city=delhi&minPrice=5000&maxPrice=7000 (Range Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=7000",
