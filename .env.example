# ==============================================================================
# Hotel Offer Orchestrator - Environment Variables Template
# ==============================================================================

# Application Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
# When using Docker Compose, REDIS_HOST=redis
# When running locally without Redis installed, set REDIS_USE_MOCK=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
REDIS_USE_MOCK=true

# Temporal Configuration
# When using Docker Compose, TEMPORAL_ADDRESS=temporal:7233 and TEMPORAL_STANDALONE_MODE=false
# When running locally without Temporal, set TEMPORAL_STANDALONE_MODE=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers-queue
TEMPORAL_STANDALONE_MODE=true
TEMPORAL_STANDALONE_FALLBACK=true

# Supplier Configuration
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
